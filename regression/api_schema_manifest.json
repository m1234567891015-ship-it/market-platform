      "required_paths": ["symbol", "calls", "puts", "summary"],
      "types": {"symbol": "string", "calls": "array", "puts": "array", "summary": "object"}
    },
    {
      "path_pattern": "/api/us-market/search",
      "required_paths": ["query", "count", "results"],
      "types": {"query": "string", "count": "integer", "results": "array"}
    },
    {
      "path_pattern": "/api/us-market/sector-stocks",
      "required_paths": ["sector", "items", "usable"],
      "types": {"sector": "string", "items": "array", "usable": "integer"}
    },
    {
      "path_pattern": "/api/us-market/symbol/*",
      "required_paths": ["symbol", "name", "market", "source"],
      "types": {"symbol": "string", "name": "string", "market": "string", "source": "string"}
    },
    {
      "path_pattern": "/api/yahoo/sector-chart",
      "required_paths": ["benchmarkComparisonSeries", "candles", "chartIntervals", "symbol"],
      "types": {"benchmarkComparisonSeries": "object", "candles": "array", "chartIntervals": "object", "symbol": "string"}
    },
    {
      "path_pattern": "/api/yahoo/sector",
      "required_paths": ["count", "group", "index", "items"],
      "types": {"count": "integer", "group": "string", "index": "integer", "items": "array"}
    }
  ]
}
